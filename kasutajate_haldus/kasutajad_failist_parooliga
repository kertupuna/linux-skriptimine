#!/bin/sh
# Ülesanne 3 - kasutajad paroolidega failist
#
# Kasutamine:  sh kasutajad_failist_parooliga kasutajad_paroolid
# Faili iga rida on kujul kasutajanimi:parool (parool avatud kujul).
# Skript loob kasutaja ja salvestab parooli krüpteeritult /etc/shadow faili.

if [ $# -ne 1 ]; then
    echo "Kasutamine: $0 failinimi"
    exit 1
fi

FAIL="$1"

if [ ! -f "$FAIL" ] || [ ! -r "$FAIL" ]; then
    echo "Fail $FAIL puudub või ei ole loetav"
    exit 2
fi

# IFS=: jagab rea koolonist kaheks: kasutajanimi ja parool
while IFS=: read -r NIMI PAROOL || [ -n "$NIMI" ]; do
    [ -z "$NIMI" ] && continue

    if id "$NIMI" >/dev/null 2>&1; then
        echo "Kasutaja $NIMI on juba olemas, jätan vahele"
        continue
    fi

    # Loome kasutaja koos kodukataloogiga
    useradd -m -d "/home/$NIMI" -s /bin/bash "$NIMI"
    if [ $? -ne 0 ]; then
        echo "Probleem kasutaja $NIMI lisamisega"
        continue
    fi

    # chpasswd loeb kuju kasutaja:parool ja kirjutab räsi /etc/shadow faili
    echo "$NIMI:$PAROOL" | chpasswd
    if [ $? -eq 0 ]; then
        echo "Kasutaja $NIMI on lisatud koos parooliga"
        grep "^$NIMI:" /etc/shadow
    else
        echo "Kasutaja $NIMI lisati, aga parooli määramine ebaõnnestus"
    fi
done < "$FAIL"
